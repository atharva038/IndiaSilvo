{%- comment -%} Typography & Google Fonts preconnect {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Marcellus&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

<style>
  :root {
    --color-bg: {{ settings.color_bg | default: '#FAF8F5' }};
    --color-surface: {{ settings.color_surface | default: '#FFFFFF' }};
    --color-surface-alt: {{ settings.color_surface_alt | default: '#F4EFEA' }};
    --color-text-primary: {{ settings.color_text_primary | default: '#1C1917' }};
    --color-text-secondary: {{ settings.color_text_secondary | default: '#5C554E' }};
    --color-text-muted: {{ settings.color_text_muted | default: '#8C847D' }};
    --color-border: {{ settings.color_border | default: '#EBE4DB' }};
    --color-accent-gold: {{ settings.color_accent_gold | default: '#B38E5D' }};
    --color-accent-gold-hover: {{ settings.color_accent_gold_hover | default: '#9A7545' }};
    --color-button-bg: {{ settings.color_button_bg | default: '#1C1917' }};
    --color-button-text: {{ settings.color_button_text | default: '#FAF8F5' }};
    --color-button-hover-bg: {{ settings.color_button_hover_bg | default: '#352F2B' }};
    --color-badge-sale-bg: {{ settings.color_badge_sale_bg | default: '#B38E5D' }};
    --color-badge-sale-text: {{ settings.color_badge_sale_text | default: '#FFFFFF' }};

    --font-heading: 'Marcellus', 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
    --font-body: 'Plus Jakarta Sans', 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-body-base-size: {{ settings.font_body_base_size | default: 15 }}px;
    --heading-scale: {{ settings.heading_scale | default: 100 | divided_by: 100.0 }};

    --page-max-width: {{ settings.page_max_width | default: 1360 }}px;
    --page-wide-max-width: {{ settings.page_wide_max_width | default: 1560 }}px;
    --border-radius: {{ settings.border_radius | default: 2 }}px;
  }
</style>

