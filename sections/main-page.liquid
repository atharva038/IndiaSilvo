{{ 'section-pages.css' | asset_url | stylesheet_tag }}

<div class="page-section section-spacing" data-section-id="{{ section.id }}">
  <div class="container container-narrow">
    
    <div class="page-breadcrumbs-wrapper">
      {% render 'breadcrumbs' %}
    </div>

    <header class="section-header page-header">
      <h1 class="page-title h2">{{ page.title | escape }}</h1>
      <div class="gold-divider"></div>
    </header>

    <div class="page-content rte">
      {{ page.content }}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
