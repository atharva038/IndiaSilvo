{{ 'section-main-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
-%}

<div class="product-section" data-section-id="{{ section.id }}">
  <div class="container">
    
    <div class="product-layout-grid">
      
      {%- comment -%} Left Column: High-Res Editorial Gallery {%- endcomment -%}
      <div class="product-gallery">
        <div class="product-gallery__main-image-wrap">
          {%- if featured_media != blank -%}
            <img
              id="ProductMainImage"
              src="{{ featured_media | image_url: width: 1200 }}"
              srcset="{{ featured_media | image_url: width: 600 }} 600w,
                      {{ featured_media | image_url: width: 900 }} 900w,
                      {{ featured_media | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 50vw, 100vw"
              alt="{{ featured_media.alt | default: product.title | escape }}"
              class="product-gallery__main-img"
              loading="eager"
              width="1200"
              height="1500"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'product-gallery__main-img placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbnails">
            {%- for media in product.media -%}
              <button
                type="button"
                class="product-gallery__thumb {% if forloop.first %}is-active{% endif %}"
                data-target-image-src="{{ media | image_url: width: 1200 }}"
                aria-label="View image {{ forloop.index }}"
                onclick="document.getElementById('ProductMainImage').src = this.dataset.targetImageSrc; document.querySelectorAll('.product-gallery__thumb').forEach(t => t.classList.remove('is-active')); this.classList.add('is-active');"
              >
                <img
                  src="{{ media | image_url: width: 180, height: 225, crop: 'center' }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="72"
                  height="90"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Right Column: Product Details & Purchase Controls {%- endcomment -%}
      <div class="product-info-panel">
        
        {%- if product.vendor != blank -%}
          <span class="product-vendor-badge">{{ product.vendor }}</span>
        {%- endif -%}

        <h1 class="product-main-title">{{ product.title }}</h1>

        <div class="product-pricing-row">
          <span class="product-price-current" id="ProductPrice">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="product-price-compare" id="ProductComparePrice">{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        <div class="product-tax-notice">
          {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t }}
        </div>

        {%- form 'product', product, id: 'product-form', class: 'product-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            <div class="variant-pickers" style="display:flex; flex-direction:column; gap:1.25rem; margin-bottom:1.5rem;">
              {%- for option in product.options_with_values -%}
                <div class="variant-option-group">
                  <label class="variant-option-label" for="Option-{{ option.position }}">
                    {{ option.name }}: <span style="font-weight:400;">{{ option.selected_value }}</span>
                  </label>
                  <div class="variant-pill-list">
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="variant-pill {% if option.selected_value == value %}is-selected{% endif %}"
                        data-option-index="{{ option.position }}"
                        data-value="{{ value | escape }}"
                      >
                        {{ value }}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <div class="product-add-group">
            <div class="quantity-stepper" style="height:48px;">
              <button type="button" class="quantity-stepper__btn" onclick="const input = this.parentNode.querySelector('input'); input.value = Math.max(1, parseInt(input.value)-1);">
                {% render 'icons', icon: 'minus' %}
              </button>
              <input type="number" name="quantity" value="1" min="1" class="quantity-stepper__input" style="width:44px; font-size:14px;">
              <button type="button" class="quantity-stepper__btn" onclick="const input = this.parentNode.querySelector('input'); input.value = parseInt(input.value)+1;">
                {% render 'icons', icon: 'plus' %}
              </button>
            </div>

            <button
              type="submit"
              name="add"
              class="btn btn-primary"
              style="flex: 1; height: 48px;"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                {{ 'sections.main_product.add_to_cart' | t }}
              {%- else -%}
                {{ 'sections.main_product.sold_out' | t }}
              {%- endif -%}
            </button>
          </div>

          {%- if section.settings.show_dynamic_checkout -%}
            <div style="margin-top: 0.75rem;">
              {{ form | payment_button }}
            </div>
          {%- endif -%}
        {%- endform -%}

        {%- comment -%} Size Guide Trigger & Trust Badges {%- endcomment -%}
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem;">
          <button type="button" class="btn-link" data-modal-trigger="size-guide" style="font-size: 11px;">
            {% render 'icons', icon: 'diamond' %}
            <span>925 Ring & Chain Size Guide</span>
          </button>
          <span style="font-size: 11px; color: var(--color-accent-gold); font-weight: 500;">
            ✓ BIS Hallmarked 925
          </span>
        </div>

        {%- comment -%} 925 Silver Purity Guarantee Badge {%- endcomment -%}
        {% render 'silver-purity-badge' %}

        {%- comment -%} Trust Feature Highlights {%- endcomment -%}
        <div style="display:flex; flex-wrap:wrap; gap:1rem; margin-top:1rem; padding:1rem 0; border-top:1px solid var(--color-border); border-bottom:1px solid var(--color-border);">
          <div style="display:flex; align-items:center; gap:6px; font-size:12px; color:var(--color-text-secondary);">
            {% render 'icons', icon: 'shield-check' %}
            <span>925 BIS Laser Hallmarked</span>
          </div>
          <div style="display:flex; align-items:center; gap:6px; font-size:12px; color:var(--color-text-secondary);">
            {% render 'icons', icon: 'truck' %}
            <span>Complimentary Insured Shipping</span>
          </div>
          <div style="display:flex; align-items:center; gap:6px; font-size:12px; color:var(--color-text-secondary);">
            {% render 'icons', icon: 'sparkle' %}
            <span>Anti-Tarnish Rhodium E-Coat</span>
          </div>
        </div>

        {%- comment -%} Collapsible Accordions (Description, Metafield Specs, Care, Shipping) {%- endcomment -%}
        <div class="product-accordions">
          
          <div class="accordion-item is-active">
            <button type="button" class="accordion-header" aria-expanded="true">
              <span>{{ 'sections.main_product.specifications' | t }}</span>
              <span class="accordion-icon">{% render 'icons', icon: 'chevron-down' %}</span>
            </button>
            <div class="accordion-content" style="max-height: 500px;">
              <div class="accordion-inner">
                {{ product.description }}
                {%- if product.metafields.custom.material != blank or product.metafields.custom.purity != blank or product.metafields.custom.weight != blank -%}
                  <ul style="margin-top: 1rem; list-style: none; display: flex; flex-direction: column; gap: 6px; font-size: 13px;">
                    {%- if product.metafields.custom.material != blank -%}
                      <li><strong>Material:</strong> {{ product.metafields.custom.material }}</li>
                    {%- endif -%}
                    {%- if product.metafields.custom.purity != blank -%}
                      <li><strong>Purity:</strong> {{ product.metafields.custom.purity }}</li>
                    {%- endif -%}
                    {%- if product.metafields.custom.weight != blank -%}
                      <li><strong>Gross Weight:</strong> {{ product.metafields.custom.weight }}</li>
                    {%- endif -%}
                    {%- if product.metafields.custom.stone_details != blank -%}
                      <li><strong>Stone Details:</strong> {{ product.metafields.custom.stone_details }}</li>
                    {%- endif -%}
                  </ul>
                {%- endif -%}
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <button type="button" class="accordion-header" aria-expanded="false">
              <span>{{ 'sections.main_product.shipping_returns' | t }}</span>
              <span class="accordion-icon">{% render 'icons', icon: 'chevron-down' %}</span>
            </button>
            <div class="accordion-content">
              <div class="accordion-inner">
                <p>All Indiasilvo creations are dispatched with full transit insurance in our signature velvet keepsake boxes. We provide complimentary domestic shipping and hassle-free 7-day returns for unworn pieces in original condition with hallmarking certificates intact.</p>
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <button type="button" class="accordion-header" aria-expanded="false">
              <span>{{ 'sections.main_product.care_guide' | t }}</span>
              <span class="accordion-icon">{% render 'icons', icon: 'chevron-down' %}</span>
            </button>
            <div class="accordion-content">
              <div class="accordion-inner">
                <p>To preserve the radiant luster of pure 925 sterling silver, avoid direct contact with perfumes, lotions, and chlorine. Store individually in your Indiasilvo anti-tarnish velvet pouch when not worn.</p>
              </div>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Product Details",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show Dynamic Checkout Buttons",
      "default": true
    }
  ]
}
{% endschema %}
