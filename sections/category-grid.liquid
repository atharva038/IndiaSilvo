<section id="CategoryGrid-{{ section.id }}" class="category-grid-section section-spacing" data-section-id="{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-header__subtitle">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-header__title h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="section-header__description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="category-tiles-grid category-tiles-grid--{{ section.settings.card_style | default: 'editorial_card' }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            if collection == blank
              case forloop.index
                when 1
                  assign collection = collections['rings'] | default: collections['frontpage'] | default: collections['all']
                when 2
                  assign collection = collections['necklaces'] | default: collections['pendants'] | default: collections['all']
                when 3
                  assign collection = collections['earrings'] | default: collections['all']
                when 4
                  assign collection = collections['cuffs-bangles'] | default: collections['bracelets'] | default: collections['all']
              endcase
            endif
            assign target_url = collection.url | default: routes.all_products_collection_url
            assign target_image = block.settings.image | default: collection.featured_image
            assign target_title = block.settings.title | default: collection.title | default: 'Fine Jewellery'
          -%}
          <div class="category-tile-item" {{ block.shopify_attributes }}>
            <a href="{{ target_url }}" class="category-tile-link">
              
              <div class="category-tile-media">
                {%- if target_image != blank -%}
                  <img
                    src="{{ target_image | image_url: width: 800 }}"
                    srcset="{{ target_image | image_url: width: 400 }} 400w,
                            {{ target_image | image_url: width: 800 }} 800w"
                    sizes="(min-width: 990px) 25vw, 50vw"
                    alt="{{ target_image.alt | default: target_title | escape }}"
                    class="category-tile-img"
                    loading="lazy"
                    width="800"
                    height="1000"
                  >
                {%- else -%}
                  {%- case forloop.index -%}
                    {%- when 1 -%}
                      <img src="{{ 'collection-silver-rings.jpg' | asset_url }}" alt="925 Silver Rings" class="category-tile-img" loading="lazy" width="800" height="1000">
                    {%- when 2 -%}
                      <img src="{{ 'collection-silver-necklaces.jpg' | asset_url }}" alt="Silver Pendants & Chains" class="category-tile-img" loading="lazy" width="800" height="1000">
                    {%- when 3 -%}
                      <img src="{{ 'category-silver-earrings.jpg' | asset_url }}" alt="Silver Earrings" class="category-tile-img" loading="lazy" width="800" height="1000">
                    {%- when 4 -%}
                      <img src="{{ 'collection-silver-cuffs.jpg' | asset_url }}" alt="Silver Cuffs & Kada" class="category-tile-img" loading="lazy" width="800" height="1000">
                    {%- else -%}
                      <img src="{{ 'collection-silver-rings.jpg' | asset_url }}" alt="925 Silver" class="category-tile-img" loading="lazy" width="800" height="1000">
                  {%- endcase -%}
                {%- endif -%}
                <div class="category-tile-overlay"></div>
              </div>

              <div class="category-tile-info">
                <h3 class="category-tile-title">
                  {{ target_title }}
                </h3>
                <span class="btn-link category-tile-btn">
                  <span>Explore</span>
                  {% render 'icons', icon: 'arrow-right' %}
                </span>
              </div>

            </a>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for collection in collections limit: 4 -%}
          <div class="category-tile-item">
            <a href="{{ collection.url }}" class="category-tile-link">
              <div class="category-tile-media">
                {%- if collection.featured_image != blank -%}
                  <img
                    src="{{ collection.featured_image | image_url: width: 800 }}"
                    alt="{{ collection.title | escape }}"
                    class="category-tile-img"
                    loading="lazy"
                    width="800"
                    height="1000"
                  >
                {%- else -%}
                  <img src="{{ 'collection-silver-rings.jpg' | asset_url }}" alt="{{ collection.title | escape }}" class="category-tile-img" loading="lazy" width="800" height="1000">
                {%- endif -%}
                <div class="category-tile-overlay"></div>
              </div>
              <div class="category-tile-info">
                <h3 class="category-tile-title">{{ collection.title }}</h3>
                <span class="btn-link category-tile-btn">
                  <span>Explore</span>
                  {% render 'icons', icon: 'arrow-right' %}
                </span>
              </div>
            </a>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

<style>
  .category-grid-section {
    position: relative;
  }
  .category-tiles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }
  @media (min-width: 990px) {
    .category-tiles-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .category-tile-item {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background-color: #1A1715;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }
  .category-tile-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
  }

  .category-tile-link {
    display: block;
    position: relative;
    text-decoration: none;
    height: 100%;
  }

  .category-tile-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    background-color: var(--color-surface-alt);
    overflow: hidden;
  }

  .category-tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .category-tile-item:hover .category-tile-img {
    transform: scale(1.06);
  }

  .category-tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(24, 22, 21, 0.75) 0%, rgba(24, 22, 21, 0.1) 50%, transparent 100%);
    transition: background 0.4s ease;
  }
  .category-tile-item:hover .category-tile-overlay {
    background: linear-gradient(to top, rgba(24, 22, 21, 0.85) 0%, rgba(24, 22, 21, 0.2) 50%, transparent 100%);
  }

  .category-tile-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: clamp(1rem, 2vw, 1.5rem);
    text-align: center;
    color: #FAF8F5;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
  }

  .category-tile-title {
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    color: #FAF8F5;
    margin-bottom: 6px;
    line-height: 1.25;
    letter-spacing: 0.02em;
    font-weight: 400;
  }

  .category-tile-btn {
    color: #FAF8F5 !important;
    border-color: rgba(250, 248, 245, 0.7) !important;
    font-size: 11px !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase;
  }
  .category-tile-item:hover .category-tile-btn {
    color: #C8A876 !important;
    border-color: #C8A876 !important;
  }
</style>

{% schema %}
{
  "name": "Shop By Category",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Bespoke Categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Shop By Silver Silhouette"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Curated collections designed to harmonize with your personal aesthetic."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Tile Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title Override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Category",
      "blocks": [
        { "type": "category", "settings": { "title": "925 Silver Rings" } },
        { "type": "category", "settings": { "title": "Pendants & Chains" } },
        { "type": "category", "settings": { "title": "Earrings & Jhumkas" } },
        { "type": "category", "settings": { "title": "Cuffs & Kada" } }
      ]
    }
  ]
}
{% endschema %}
