<section id="BrandStory-{{ section.id }}" class="brand-story-section section-spacing" data-section-id="{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    <div class="brand-story-grid {% if section.settings.image_position == 'right' %}brand-story-grid--reverse{% endif %}">
      
      {%- comment -%} Media Column {%- endcomment -%}
      <div class="brand-story__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1000 }}"
            srcset="{{ section.settings.image | image_url: width: 500 }} 500w,
                    {{ section.settings.image | image_url: width: 1000 }} 1000w"
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
            class="brand-story__img"
            loading="lazy"
            width="1000"
            height="1200"
          >
        {%- else -%}
          <div class="placeholder-svg-wrapper" style="background: #252220; width:100%; height:100%; min-height:400px;">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg brand-story__img' }}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Narrative Column {%- endcomment -%}
      <div class="brand-story__content">
        {%- if section.settings.subtitle != blank -%}
          <span class="section-header__subtitle" style="text-align:left;">{{ section.settings.subtitle | escape }}</span>
        {%- endif -%}

        <h2 class="brand-story__title h2">{{ section.settings.title | escape }}</h2>
        <div class="gold-divider" style="margin-left: 0; margin-top: 0.75rem; margin-bottom: 1.25rem;"></div>
        
        <div class="brand-story__text">
          {{ section.settings.text }}
        </div>

        {%- if section.settings.show_details -%}
          <div class="brand-story-pillars">
            <div class="brand-story-pillar">
              <span class="brand-story-pillar__num">92.5%</span>
              <span class="brand-story-pillar__label">Precious Metal Purity</span>
            </div>
            <div class="brand-story-pillar">
              <span class="brand-story-pillar__num">100%</span>
              <span class="brand-story-pillar__label">BIS Laser Hallmarked</span>
            </div>
            <div class="brand-story-pillar">
              <span class="brand-story-pillar__num">0%</span>
              <span class="brand-story-pillar__label">Nickel & Lead Free</span>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.button_text != blank -%}
          <div style="margin-top: var(--space-xl);">
            <a href="{{ section.settings.button_url | default: '/pages/about' }}" class="btn btn-primary">
              {{ section.settings.button_text | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<style>
  .brand-story-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  @media (min-width: 990px) {
    .brand-story-grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand-story-grid--reverse .brand-story__media {
      order: 2;
    }
    .brand-story-grid--reverse .brand-story__content {
      order: 1;
    }
  }
  .brand-story__media {
    position: relative;
    aspect-ratio: 4/5;
    background-color: var(--color-surface-alt);
    overflow: hidden;
    border-radius: var(--border-radius, 0);
    box-shadow: var(--shadow-card);
  }
  .brand-story__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }
  .brand-story__media:hover .brand-story__img {
    transform: scale(1.03);
  }
  .brand-story__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .brand-story__title {
    margin-bottom: var(--space-xs);
    font-size: clamp(1.85rem, 3.2vw, 2.5rem);
    line-height: 1.25;
  }
  .brand-story__text {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.8;
  }
  .brand-story-pillars {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .brand-story-pillar {
    display: flex;
    flex-direction: column;
  }
  .brand-story-pillar__num {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-accent-gold);
    line-height: 1;
  }
  .brand-story-pillar__label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-top: 4px;
  }
</style>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Atelier Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position on Desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The Silversmith Heritage"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Honoring Pure Sterling Silver"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Narrative Body",
      "default": "<p>Indiasilvo was founded on a singular passion: celebrating sterling silver as the ultimate medium of modern fine jewellery. We blend royal Indian silver-craft traditions with architectural minimalism.</p><p>Each creation is cast strictly in BIS hallmarked 925 sterling silver, electro-coated with liquid rhodium for lifetime tarnish resistance, and finished by fifth-generation master artisans.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_details",
      "label": "Show Craft Metrics (Purity, Hallmark, Quality)",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Discover Our Atelier"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
