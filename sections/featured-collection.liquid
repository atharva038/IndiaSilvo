<div class="featured-collection-section section-spacing" data-section-id="{{ section.id }}">
  <div class="container">
    
    <div class="section-header">
      {%- if section.settings.subtitle != blank -%}
        <span class="section-header__subtitle">{{ section.settings.subtitle | escape }}</span>
      {%- endif -%}
      <h2 class="section-header__title h2">{{ section.settings.title | escape }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="section-header__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    {%- assign target_collection = section.settings.collection | default: collections['all'] -%}
    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}-col">
      {%- if target_collection != blank and target_collection.products_count > 0 -%}
        {%- for product in target_collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- elsif collections.all.products_count > 0 -%}
        {%- for product in collections.all.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank -%}
      <div style="text-align: center; margin-top: clamp(2rem, 4vw, 3.5rem);">
        <a href="{{ collection.url }}" class="btn btn-secondary">
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Curated Selection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Signature Creations"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Each piece is cast in certified pure 925 sterling silver and hand-finished by master silversmiths."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
