<section id="Craftsmanship-{{ section.id }}" class="craftsmanship-section section-spacing" data-section-id="{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-header__subtitle">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-header__title h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="section-header__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    <div class="craftsmanship-points-grid">
      {%- for block in section.blocks -%}
        <div class="craftsmanship-point-card" {{ block.shopify_attributes }}>
          <div class="craftsmanship-point-icon">
            {%- case block.settings.icon -%}
              {%- when 'shield-check' -%}
                {% render 'icons', icon: 'shield-check' %}
              {%- when 'diamond' -%}
                {% render 'icons', icon: 'diamond' %}
              {%- when 'sparkle' -%}
                {% render 'icons', icon: 'sparkle' %}
              {%- when 'truck' -%}
                {% render 'icons', icon: 'truck' %}
              {%- else -%}
                {% render 'icons', icon: 'shield-check' %}
            {%- endcase -%}
          </div>

          <h3 class="craftsmanship-point-title">{{ block.settings.title | escape }}</h3>
          <p class="craftsmanship-point-text">{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
  .craftsmanship-points-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  @media (min-width: 768px) {
    .craftsmanship-points-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .craftsmanship-points-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .craftsmanship-point-card {
    background-color: var(--color-surface);
    padding: clamp(1.75rem, 2.5vw, 2.25rem);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius, 0);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .craftsmanship-point-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  .craftsmanship-point-icon {
    color: var(--color-accent-gold);
    margin-bottom: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .craftsmanship-point-icon svg {
    width: 28px;
    height: 28px;
  }

  .craftsmanship-point-title {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    margin-bottom: var(--space-xs);
    color: var(--color-text-primary);
  }

  .craftsmanship-point-text {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "Craftsmanship & Trust",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "The Indiasilvo Standard"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Uncompromising Quality & Authenticity"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Every creation is built to sovereign metallurgical benchmarks, certified for purity, and finished for a lifetime of brilliance."
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Quality Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Pillar Icon",
          "options": [
            { "value": "shield-check", "label": "925 Hallmark Shield" },
            { "value": "sparkle", "label": "Anti-Tarnish Sparkle" },
            { "value": "diamond", "label": "Hand-Set Diamond" },
            { "value": "truck", "label": "Insured Shipping" }
          ],
          "default": "shield-check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Pillar Heading",
          "default": "925 BIS Hallmarking"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Strict 92.5% silver purity certified with sovereign Bureau of Indian Standards laser hallmark."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Craftsmanship & Trust",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon": "shield-check",
            "title": "925 BIS Hallmarking",
            "text": "Strict 92.5% silver purity certified with sovereign Bureau of Indian Standards laser hallmark."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "sparkle",
            "title": "Anti-Tarnish Rhodium",
            "text": "Triple electro-plated with liquid rhodium to permanently resist atmospheric oxidation."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "diamond",
            "title": "AAA Gemstones",
            "text": "Hand-cut stones and pavé solitaires hand-set under 20x magnification for zero fallout."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "truck",
            "title": "Insured Transit",
            "text": "Dispatched in velvet keepsake boxes with complimentary insurance and tamper-proof seals."
          }
        }
      ]
    }
  ]
}
{% endschema %}
