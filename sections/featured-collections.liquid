<section id="FeaturedCollections-{{ section.id }}" class="featured-collections-section section-spacing" data-section-id="{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-header__subtitle">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-header__title h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="section-header__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    <div class="editorial-collections-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            if collection == blank
              case forloop.index
                when 1
                  assign collection = collections['rings'] | default: collections['frontpage'] | default: collections['all']
                when 2
                  assign collection = collections['necklaces'] | default: collections['pendant'] | default: collections['all']
                when 3
                  assign collection = collections['cuffs-bangles'] | default: collections['bracelets'] | default: collections['all']
              endcase
            endif
            assign target_url = collection.url | default: routes.all_products_collection_url
            assign target_image = block.settings.image | default: collection.featured_image
            assign target_title = block.settings.title | default: collection.title | default: 'Signature Collection'
          -%}
          <div class="editorial-collection-card {% if forloop.first and section.settings.highlight_first %}editorial-collection-card--featured{% endif %}" {{ block.shopify_attributes }}>
            <a href="{{ target_url }}" class="editorial-collection-card__link">
              
              <div class="editorial-collection-card__media">
                {%- if target_image != blank -%}
                  <img
                    src="{{ target_image | image_url: width: 1000 }}"
                    srcset="{{ target_image | image_url: width: 500 }} 500w,
                            {{ target_image | image_url: width: 1000 }} 1000w"
                    sizes="(min-width: 990px) 33vw, 100vw"
                    alt="{{ target_image.alt | default: target_title | escape }}"
                    class="editorial-collection-card__img"
                    loading="lazy"
                    width="1000"
                    height="1250"
                  >
                {%- else -%}
                  {%- case forloop.index -%}
                    {%- when 1 -%}
                      <img src="{{ 'collection-silver-rings.jpg' | asset_url }}" alt="925 Silver Rings Collection" class="editorial-collection-card__img" loading="lazy" width="1000" height="1250">
                    {%- when 2 -%}
                      <img src="{{ 'collection-silver-necklaces.jpg' | asset_url }}" alt="925 Silver Pendants & Necklaces" class="editorial-collection-card__img" loading="lazy" width="1000" height="1250">
                    {%- when 3 -%}
                      <img src="{{ 'collection-silver-cuffs.jpg' | asset_url }}" alt="925 Silver Cuffs & Bangles" class="editorial-collection-card__img" loading="lazy" width="1000" height="1250">
                    {%- else -%}
                      <img src="{{ 'collection-silver-rings.jpg' | asset_url }}" alt="925 Silver Creations" class="editorial-collection-card__img" loading="lazy" width="1000" height="1250">
                  {%- endcase -%}
                {%- endif -%}
                <div class="editorial-collection-card__overlay"></div>
              </div>

              <div class="editorial-collection-card__content">
                <span class="editorial-collection-card__eyebrow">{{ block.settings.eyebrow | default: '925 Sterling Silver' }}</span>
                <h3 class="editorial-collection-card__title">
                  {{ target_title }}
                </h3>
                {%- if block.settings.description != blank or collection.description != blank -%}
                  <p class="editorial-collection-card__desc">{{ block.settings.description | default: collection.description | strip_html | truncatewords: 15 }}</p>
                {%- endif -%}
                <span class="btn-link" style="color:#FAF8F5; border-color: rgba(250,248,245,0.7); margin-top:0.5rem;">
                  <span>{{ block.settings.button_label | default: 'Explore Series' }}</span>
                  {% render 'icons', icon: 'arrow-right' %}
                </span>
              </div>

            </a>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for collection in collections limit: 3 -%}
          <div class="editorial-collection-card">
            <a href="{{ collection.url }}" class="editorial-collection-card__link">
              <div class="editorial-collection-card__media">
                {%- if collection.featured_image != blank -%}
                  <img
                    src="{{ collection.featured_image | image_url: width: 1000 }}"
                    alt="{{ collection.title | escape }}"
                    class="editorial-collection-card__img"
                    loading="lazy"
                    width="1000"
                    height="1250"
                  >
                {%- else -%}
                  <img src="{{ 'collection-silver-rings.jpg' | asset_url }}" alt="{{ collection.title | escape }}" class="editorial-collection-card__img" loading="lazy" width="1000" height="1250">
                {%- endif -%}
                <div class="editorial-collection-card__overlay"></div>
              </div>
              <div class="editorial-collection-card__content">
                <span class="editorial-collection-card__eyebrow">925 Sterling Silver</span>
                <h3 class="editorial-collection-card__title">{{ collection.title }}</h3>
                <span class="btn-link" style="color:#FAF8F5; border-color: rgba(250,248,245,0.7); margin-top:0.5rem;">
                  <span>Explore Series</span>
                  {% render 'icons', icon: 'arrow-right' %}
                </span>
              </div>
            </a>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

<style>
  .editorial-collections-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  @media (min-width: 768px) {
    .editorial-collections-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .editorial-collection-card {
    position: relative;
    overflow: hidden;
    background-color: var(--color-surface-alt);
    border-radius: var(--border-radius, 0);
  }

  .editorial-collection-card__link {
    display: block;
    position: relative;
    height: 100%;
    text-decoration: none;
    color: #FAF8F5;
  }

  .editorial-collection-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    overflow: hidden;
  }

  .editorial-collection-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .editorial-collection-card:hover .editorial-collection-card__img {
    transform: scale(1.05);
  }

  .editorial-collection-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(24, 22, 21, 0.75) 0%, rgba(24, 22, 21, 0.15) 50%, transparent 100%);
    transition: background-color var(--transition-normal);
  }

  .editorial-collection-card:hover .editorial-collection-card__overlay {
    background: linear-gradient(to top, rgba(24, 22, 21, 0.85) 0%, rgba(24, 22, 21, 0.25) 50%, transparent 100%);
  }

  .editorial-collection-card__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .editorial-collection-card__eyebrow {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-widest);
    color: var(--color-accent-gold);
    margin-bottom: 4px;
    font-weight: 500;
  }

  .editorial-collection-card__title {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    color: #FAF8F5;
    margin-bottom: 4px;
    line-height: 1.25;
  }

  .editorial-collection-card__desc {
    font-size: var(--font-size-xs);
    color: rgba(250, 248, 245, 0.85);
    line-height: 1.5;
    margin-bottom: 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

{% schema %}
{
  "name": "Featured Collections",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Curated Silhouettes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Signature 925 Silver Collections"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Explore architectural statements handcrafted from hallmarked sterling silver and handset gemstones."
    },
    {
      "type": "checkbox",
      "id": "highlight_first",
      "label": "Highlight First Collection",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image Override"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Card Eyebrow",
          "default": "High Jewellery"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title Override"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short Summary"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Explore Series"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        {
          "type": "collection_block",
          "settings": {
            "eyebrow": "Solitaire Series",
            "title": "925 Silver Rings",
            "description": "Architectural solitaires and pavé statement bands."
          }
        },
        {
          "type": "collection_block",
          "settings": {
            "eyebrow": "Filigree Series",
            "title": "Pendants & Chains",
            "description": "Intricate openwork medallions and delicate drops."
          }
        },
        {
          "type": "collection_block",
          "settings": {
            "eyebrow": "Artisan Series",
            "title": "Cuffs & Kada",
            "description": "Heavy chiselled silver bracelets and geometric cuffs."
          }
        }
      ]
    }
  ]
}
{% endschema %}
