<section id="FeaturedProducts-{{ section.id }}" class="featured-products-section section-spacing" data-section-id="{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-header__subtitle">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-header__title h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="section-header__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    {%- liquid
      assign target_collection = section.settings.collection
      if target_collection == blank or target_collection.products.size == 0
        assign target_collection = collections['all']
      endif
      if target_collection == blank or target_collection.products.size == 0
        assign target_collection = collections.all
      endif
      if target_collection == blank or target_collection.products.size == 0
        for coll in collections
          if coll.products.size > 0
            assign target_collection = coll
            break
          endif
        endfor
      endif
    -%}

    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}-col">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            {% render 'product-card', product: block.settings.product %}
          {%- endif -%}
        {%- endfor -%}
      {%- elsif target_collection != blank and target_collection.products.size > 0 -%}
        {%- for product in target_collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <div class="product-card">
            <div class="product-card__media-wrapper" style="--product-card-aspect-ratio: 4/5;">
              <div class="placeholder-svg-wrapper" style="background: #252220; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg product-card__image' }}
              </div>
            </div>
            <div class="product-card__info">
              <span class="product-card__vendor">925 Pure Silver</span>
              <h3 class="product-card__title"><a href="#">Sterling Silver Creation {{ i }}</a></h3>
              <div class="price"><span class="price-item price-item--regular">₹2,499</span></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and target_collection != blank and target_collection.products.size > section.settings.products_to_show -%}
      <div style="text-align: center; margin-top: clamp(2.5rem, 4vw, 4rem);">
        <a href="{{ target_collection.url | default: routes.all_products_collection_url }}" class="btn btn-secondary">
          {{ section.settings.view_all_label | default: 'View All Creations' }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "All Sterling Silver Creations"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Hand-forged 925 sterling silver statements designed for modern luxury and heirloom longevity."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Source Collection (Optional)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 24,
      "step": 2,
      "label": "Products to Show from Collection",
      "default": 16
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "options": [
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Button Label",
      "default": "View All Creations"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Individual Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
