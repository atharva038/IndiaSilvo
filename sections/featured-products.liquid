<section id="FeaturedProducts-{{ section.id }}" class="featured-products-section section-spacing" data-section-id="{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-header__subtitle">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-header__title h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="section-header__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    {%- assign collection = section.settings.collection -%}

    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}-col">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            {% render 'product-card', product: block.settings.product %}
          {%- endif -%}
        {%- endfor -%}
      {%- elsif collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Default 925 Silver Fallback Showcase {%- endcomment -%}
        <div class="product-card">
          <div class="product-card__media-wrapper">
            <img src="{{ 'product-silver-ring.jpg' | asset_url }}" alt="Solitaire 925 Silver Ring" class="product-card__image" loading="lazy" width="600" height="750">
            <div class="product-card__badges"><span class="badge badge-sale">925 BIS</span></div>
          </div>
          <div class="product-card__info">
            <span class="product-card__vendor">925 Sterling Silver</span>
            <h3 class="product-card__title">Aura Solitaire Brilliant Ring</h3>
            <div class="price-container"><span class="price__sale">₹3,499</span><s class="price__compare">₹4,299</s></div>
          </div>
        </div>

        <div class="product-card">
          <div class="product-card__media-wrapper">
            <img src="{{ 'product-silver-necklace.jpg' | asset_url }}" alt="925 Silver Filigree Pendant" class="product-card__image" loading="lazy" width="600" height="750">
            <div class="product-card__badges"><span class="badge badge-sale">Best Seller</span></div>
          </div>
          <div class="product-card__info">
            <span class="product-card__vendor">925 Sterling Silver</span>
            <h3 class="product-card__title">Mughal Filigree Medallion Necklace</h3>
            <div class="price-container"><span class="price__regular">₹5,899</span></div>
          </div>
        </div>

        <div class="product-card">
          <div class="product-card__media-wrapper">
            <img src="{{ 'product-silver-earrings.jpg' | asset_url }}" alt="925 Silver Drop Earrings" class="product-card__image" loading="lazy" width="600" height="750">
            <div class="product-card__badges"><span class="badge badge-sale">925 BIS</span></div>
          </div>
          <div class="product-card__info">
            <span class="product-card__vendor">925 Sterling Silver</span>
            <h3 class="product-card__title">Celestial Cascade Pear Drop Earrings</h3>
            <div class="price-container"><span class="price__regular">₹4,199</span></div>
          </div>
        </div>

        <div class="product-card">
          <div class="product-card__media-wrapper">
            <img src="{{ 'product-silver-cuff.jpg' | asset_url }}" alt="925 Silver Chiseled Cuff" class="product-card__image" loading="lazy" width="600" height="750">
            <div class="product-card__badges"><span class="badge badge-sale">Artisan Edition</span></div>
          </div>
          <div class="product-card__info">
            <span class="product-card__vendor">925 Sterling Silver</span>
            <h3 class="product-card__title">Architectural Hammered Silver Cuff</h3>
            <div class="price-container"><span class="price__sale">₹7,299</span><s class="price__compare">₹8,500</s></div>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank -%}
      <div style="text-align: center; margin-top: clamp(2.5rem, 4vw, 4rem);">
        <a href="{{ collection.url }}" class="btn btn-secondary">
          {{ section.settings.view_all_label | default: 'View All Pieces' }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Icons of Sterling Silver"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Hand-forged 925 sterling silver statements designed for modern luxury and heirloom longevity."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Source Collection (Optional)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to Show from Collection",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "options": [
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Button Label",
      "default": "View All Creations"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Individual Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
