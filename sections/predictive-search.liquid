{%- if predictive_search.performed -%}
  <div id="shopify-section-predictive-search" class="predictive-search-results">
    {%- assign total_results = predictive_search.resources.products.size | plus: predictive_search.resources.collections.size -%}
    
    {%- if total_results > 0 -%}
      
      {%- comment -%} Suggested Collections {%- endcomment -%}
      {%- if predictive_search.resources.collections.size > 0 -%}
        <div class="predictive-search-group">
          <span class="predictive-search-group__title">Collections</span>
          <div class="predictive-search-tags">
            {%- for collection in predictive_search.resources.collections -%}
              <a href="{{ collection.url }}" class="predictive-search-tag">
                {{ collection.title }}
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} Suggested Products {%- endcomment -%}
      {%- if predictive_search.resources.products.size > 0 -%}
        <div class="predictive-search-group">
          <span class="predictive-search-group__title">Creations ({{ predictive_search.resources.products.size }})</span>
          <div class="predictive-search-products-list">
            {%- for product in predictive_search.resources.products -%}
              <a href="{{ product.url }}" class="search-predictive-item">
                <div class="search-predictive-item__media">
                  {%- if product.featured_media -%}
                    <img
                      src="{{ product.featured_media | image_url: width: 120, height: 120, crop: 'center' }}"
                      alt="{{ product.title | escape }}"
                      loading="lazy"
                      width="60"
                      height="60"
                    >
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <div class="search-predictive-item__info">
                  <span class="search-predictive-item__title">{{ product.title }}</span>
                  <div class="search-predictive-item__pricing">
                    <span class="search-predictive-item__price">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <s class="search-predictive-item__compare">{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                  </div>
                </div>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} View All Link {%- endcomment -%}
      <div class="predictive-search-footer">
        <button type="submit" form="search-modal-form" class="btn btn-secondary btn-full" style="padding: 0.75rem 1rem; font-size: 11px;">
          View all results for "{{ predictive_search.terms }}"
        </button>
      </div>

    {%- else -%}
      <div class="predictive-search-empty">
        <p>No jewellery creations found matching <strong>"{{ predictive_search.terms }}"</strong></p>
        <span class="predictive-search-empty__hint">Try searching for "silver ring", "filigree", "pendant", or "cuff".</span>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Predictive Search"
}
{% endschema %}
