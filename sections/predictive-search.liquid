{%- if predictive_search.performed -%}
  <div id="shopify-section-predictive-search">
    {%- if predictive_search.resources.products.size > 0 -%}
      <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted); margin-bottom: 0.5rem;">
        Suggested Pieces ({{ predictive_search.resources.products.size }})
      </div>
      {%- for product in predictive_search.resources.products -%}
        <a href="{{ product.url }}" class="search-predictive-item" style="text-decoration: none; color: inherit;">
          <div style="width: 50px; height: 50px; background: var(--color-surface-alt); overflow: hidden; border-radius: var(--border-radius, 0);">
              <img
                src="{{ product.featured_media | image_url: width: 100, height: 100, crop: 'center' }}"
                alt="{{ product.title | escape }}"
                style="width: 100%; height: 100%; object-fit: cover;"
                width="100"
                height="100"
                loading="lazy"
              >
          </div>
          <div>
            <div style="font-family: var(--font-heading); font-size: 1.05rem; color: var(--color-text-primary);">{{ product.title }}</div>
            <div style="font-size: 13px; font-weight: 500; color: var(--color-accent-gold);">{{ product.price | money }}</div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      <div style="text-align: center; padding: 1.5rem; color: var(--color-text-secondary); font-size: 14px;">
        No creations found for "{{ predictive_search.terms }}".
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Predictive Search"
}
{% endschema %}
