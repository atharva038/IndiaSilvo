{{ 'section-pages.css' | asset_url | stylesheet_tag }}

<div class="about-section section-spacing" data-section-id="{{ section.id }}">
  <div class="container">
    
    <div class="page-breadcrumbs-wrapper">
      {% render 'breadcrumbs' %}
    </div>

    <header class="section-header" style="max-width: 800px; margin: 0 auto 4rem;">
      <span class="section-header__subtitle">{{ section.settings.subtitle | default: 'The IndiaSilvo Heritage' }}</span>
      <h1 class="h1" style="font-family: var(--font-heading); margin: 0.5rem 0 1.25rem;">{{ page.title | default: section.settings.heading | default: 'Sculpted in Pure 925 Sterling Silver' }}</h1>
      <div class="gold-divider"></div>
      <p class="section-header__description" style="font-size: 1.15rem; line-height: 1.8;">
        {{ section.settings.intro_text | default: 'Born from a devotion to generational silversmithing, IndiaSilvo crafts modern heirlooms that bridge ancient metalwork techniques with contemporary luxury design.' }}
      </p>
    </header>

    {%- comment -%} Story Blocks {%- endcomment -%}
    <div class="about-story-grid" style="display: flex; flex-direction: column; gap: 5rem; margin-bottom: 5rem;">
      
      <div class="about-story-row" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3.5rem; align-items: center;">
        <div class="about-story-content">
          <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--color-accent-gold); font-weight: 600;">Uncompromising Purity</span>
          <h2 style="font-family: var(--font-heading); font-size: clamp(1.6rem, 2.5vw, 2.2rem); margin: 0.75rem 0 1.25rem; font-weight: 500;">
            {{ section.settings.block_1_title | default: 'BIS Certified 92.5% Sterling Silver' }}
          </h2>
          <p style="font-size: 1rem; line-height: 1.8; color: var(--color-text-secondary); margin-bottom: 1.5rem;">
            {{ section.settings.block_1_text | default: 'Every piece bearing the IndiaSilvo hallmark contains precisely 92.5% pure silver alloyed with fine metals for superior strength, followed by a triple-layer precious Rhodium or 18K Gold barrier that safeguards your jewellery against tarnish.' }}
          </p>
          <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.95rem; color: var(--color-text-primary);">
            <li style="display: flex; align-items: center; gap: 0.75rem;">
              <span style="color: var(--color-accent-gold);">✓</span> Government-Accredited BIS Hallmarking
            </li>
            <li style="display: flex; align-items: center; gap: 0.75rem;">
              <span style="color: var(--color-accent-gold);">✓</span> Hypoallergenic & 100% Nickel-Free
            </li>
            <li style="display: flex; align-items: center; gap: 0.75rem;">
              <span style="color: var(--color-accent-gold);">✓</span> Individually Hand-Polished in Our Atelier
            </li>
          </ul>
        </div>
        <div class="about-story-media" style="position: relative; aspect-ratio: 4/3; background: var(--color-surface-alt); border: 1px solid var(--color-border); overflow: hidden;">
          {%- if section.settings.image_1 != blank -%}
            <img 
              src="{{ section.settings.image_1 | image_url: width: 1000 }}" 
              alt="{{ section.settings.block_1_title | escape }}" 
              loading="lazy" 
              width="1000"
              height="750"
              style="width: 100%; height: 100%; object-fit: cover;"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

    </div>

    {%- comment -%} Master Quote Banner {%- endcomment -%}
    <div class="about-quote-banner" style="background-color: var(--color-surface); border: 1px solid var(--color-border); padding: clamp(2.5rem, 5vw, 4rem); text-align: center; max-width: 900px; margin: 0 auto 5rem;">
      <span style="font-family: var(--font-heading); font-size: 3rem; color: var(--color-accent-gold); line-height: 1; display: block; margin-bottom: 0.5rem;">&ldquo;</span>
      <p style="font-family: var(--font-heading); font-size: clamp(1.25rem, 2.5vw, 1.75rem); font-style: italic; line-height: 1.6; color: var(--color-text-primary); margin: 0 0 1.5rem;">
        {{ section.settings.quote_text | default: 'We do not simply craft silver jewellery; we sculpt timeless poetry designed to be cherished across generations.' }}
      </p>
      <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--color-accent-gold); font-weight: 600;">
        — Master Silversmith, IndiaSilvo Atelier
      </span>
    </div>

    {%- comment -%} Final CTA {%- endcomment -%}
    <div style="text-align: center;">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary" style="padding: 1rem 2.5rem;">
        Explore The Creations
      </a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "About Atelier Story",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The IndiaSilvo Heritage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sculpted in Pure 925 Sterling Silver"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Introductory Text",
      "default": "Born from a devotion to generational silversmithing, IndiaSilvo crafts modern heirlooms that bridge ancient metalwork techniques with contemporary luxury design."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Story Image 1"
    },
    {
      "type": "text",
      "id": "block_1_title",
      "label": "Story Title 1",
      "default": "BIS Certified 92.5% Sterling Silver"
    },
    {
      "type": "textarea",
      "id": "block_1_text",
      "label": "Story Text 1",
      "default": "Every piece bearing the IndiaSilvo hallmark contains precisely 92.5% pure silver alloyed with fine metals for superior strength, followed by a triple-layer precious Rhodium or 18K Gold barrier that safeguards your jewellery against tarnish."
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote Text",
      "default": "We do not simply craft silver jewellery; we sculpt timeless poetry designed to be cherished across generations."
    }
  ]
}
{% endschema %}
