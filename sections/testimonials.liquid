{%- if section.blocks.size > 0 -%}
  <section id="Testimonials-{{ section.id }}" class="testimonials-section section-spacing" data-section-id="{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
    <div class="container">
      
      <div class="section-header">
        {%- if section.settings.subtitle != blank -%}
          <span class="section-header__subtitle">{{ section.settings.subtitle | escape }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="section-header__title h2">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>

      <div class="testimonials-grid">
        {%- for block in section.blocks -%}
          <div class="testimonial-card" {{ block.shopify_attributes }}>
            <div class="testimonial-stars" aria-label="5 out of 5 stars">
              {%- for i in (1..5) -%}
                {% render 'icons', icon: 'star' %}
              {%- endfor -%}
            </div>
            <blockquote class="testimonial-quote">
              "{{ block.settings.quote | escape }}"
            </blockquote>
            <div class="testimonial-author">
              <span class="testimonial-author__name">{{ block.settings.author | escape }}</span>
              {%- if block.settings.city != blank -%}
                <span class="testimonial-author__city">{{ block.settings.city | escape }}</span>
              {%- endif -%}
              <span class="testimonial-author__badge">Verified 925 Collector</span>
            </div>
          </div>
        {%- endfor -%}
      </div>

    </div>
  </section>

  <style>
    .testimonials-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
    @media (min-width: 768px) {
      .testimonials-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .testimonial-card {
      background-color: var(--color-surface);
      padding: clamp(1.75rem, 3vw, 2.5rem);
      border: 1px solid var(--color-border);
      border-radius: var(--border-radius, 0);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      text-align: center;
      transition: transform var(--transition-normal), box-shadow var(--transition-normal);
    }
    .testimonial-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-card);
    }
    .testimonial-stars {
      display: flex;
      justify-content: center;
      gap: 4px;
      margin-bottom: var(--space-md);
      color: var(--color-accent-gold);
    }
    .testimonial-stars svg {
      width: 14px;
      height: 14px;
      fill: currentColor;
    }
    .testimonial-quote {
      font-family: var(--font-heading);
      font-size: clamp(1.05rem, 1.25vw, 1.2rem);
      font-style: italic;
      color: var(--color-text-primary);
      line-height: 1.65;
      margin-bottom: var(--space-lg);
    }
    .testimonial-author {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .testimonial-author__name {
      font-size: var(--font-size-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: var(--letter-spacing-wider);
      color: var(--color-text-primary);
    }
    .testimonial-author__city {
      font-size: var(--font-size-2xs);
      color: var(--color-text-muted);
    }
    .testimonial-author__badge {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-accent-gold);
      margin-top: 4px;
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Patron Praises"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Words From Our Collectors"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Quote",
          "default": "The weight of the 925 silver and the meticulous stone setting surpassed my highest expectations. It feels like an heirloom passed down through generations."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Ananya Sharma"
        },
        {
          "type": "text",
          "id": "city",
          "label": "City / Location",
          "default": "Mumbai"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "The weight of the 925 silver and the meticulous stone setting surpassed my highest expectations. It feels like a true heirloom.",
