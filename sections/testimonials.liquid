<div class="testimonials-section section-spacing" data-section-id="{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    
    <div class="section-header">
      {%- if section.settings.subtitle != blank -%}
        <span class="section-header__subtitle">{{ section.settings.subtitle | escape }}</span>
      {%- endif -%}
      <h2 class="section-header__title h2">{{ section.settings.title | escape }}</h2>
    </div>

    <div class="testimonials-grid">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-stars">
            {%- for i in (1..5) -%}
              {% render 'icons', icon: 'star' %}
            {%- endfor -%}
          </div>
          <blockquote class="testimonial-quote">
            "{{ block.settings.quote | escape }}"
          </blockquote>
          <div class="testimonial-author">
            <span class="testimonial-author__name">{{ block.settings.author | escape }}</span>
            {%- if block.settings.city != blank -%}
              <span class="testimonial-author__city">{{ block.settings.city | escape }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
  .testimonials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (min-width: 768px) {
    .testimonials-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .testimonial-card {
    background-color: var(--color-surface);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius, 0);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: center;
  }
  .testimonial-stars {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin-bottom: var(--space-md);
  }
  .testimonial-quote {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--color-text-primary);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
  }
  .testimonial-author {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .testimonial-author__name {
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-text-primary);
  }
  .testimonial-author__city {
    font-size: var(--font-size-2xs);
    color: var(--color-text-muted);
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Patron Praises"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Words From Our Collectors"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Quote",
          "default": "The weight of the 925 silver and the meticulous stone setting surpassed my highest expectations. It feels like an heirloom passed down through generations."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Ananya Sharma"
        },
        {
          "type": "text",
          "id": "city",
          "label": "City / Location",
          "default": "Mumbai"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "The weight of the 925 silver and the meticulous stone setting surpassed my highest expectations. It feels like a true heirloom.",
            "author": "Ananya Sharma",
            "city": "Mumbai"
          }
        },
        {
