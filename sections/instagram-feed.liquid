<div class="instagram-section section-spacing-sm" data-section-id="{{ section.id }}">
  <div class="container">
    
    <div class="section-header">
      {%- if section.settings.subtitle != blank -%}
        <span class="section-header__subtitle">{{ section.settings.subtitle | escape }}</span>
      {%- endif -%}
      <h2 class="section-header__title h2">{{ section.settings.title | escape }}</h2>
      {%- if section.settings.account_handle != blank -%}
        <a href="https://instagram.com/{{ section.settings.account_handle | remove: '@' }}" target="_blank" rel="noopener" class="btn-link">
          @{{ section.settings.account_handle | remove: '@' }}
        </a>
      {%- endif -%}
    </div>

    <div class="instagram-grid">
      {%- for block in section.blocks -%}
        <div class="instagram-item" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="instagram-link" target="_blank" rel="noopener">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                srcset="{{ block.settings.image | image_url: width: 300 }} 300w,
                        {{ block.settings.image | image_url: width: 600 }} 600w"
                sizes="(min-width: 990px) 20vw, 50vw"
                alt="Instagram jewellery post"
                class="instagram-img"
                loading="lazy"
                width="600"
                height="600"
              >
            {%- else -%}
              {%- case forloop.index -%}
                {%- when 1 -%}
                  <img src="{{ 'product-silver-ring.jpg' | asset_url }}" alt="Instagram 925 Silver" class="instagram-img" loading="lazy" width="600" height="600">
                {%- when 2 -%}
                  <img src="{{ 'product-silver-necklace.jpg' | asset_url }}" alt="Instagram 925 Silver" class="instagram-img" loading="lazy" width="600" height="600">
                {%- when 3 -%}
                  <img src="{{ 'product-silver-earrings.jpg' | asset_url }}" alt="Instagram 925 Silver" class="instagram-img" loading="lazy" width="600" height="600">
                {%- when 4 -%}
                  <img src="{{ 'product-silver-cuff.jpg' | asset_url }}" alt="Instagram 925 Silver" class="instagram-img" loading="lazy" width="600" height="600">
                {%- else -%}
                  <img src="{{ 'product-silver-ring.jpg' | asset_url }}" alt="Instagram 925 Silver" class="instagram-img" loading="lazy" width="600" height="600">
              {%- endcase -%}
            {%- endif -%}
            <div class="instagram-hover-overlay">
              <span>View Piece</span>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
  .instagram-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.5rem, 1.5vw, 1rem);
  }
  @media (min-width: 768px) {
    .instagram-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .instagram-item {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    background-color: var(--color-surface-alt);
    border-radius: var(--border-radius, 0);
  }
  .instagram-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .instagram-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }
  .instagram-item:hover .instagram-img {
    transform: scale(1.06);
  }
  .instagram-hover-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(24, 22, 21, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FAF8F5;
    font-size: var(--font-size-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }
  .instagram-item:hover .instagram-hover-overlay {
    opacity: 1;
  }
</style>

{% schema %}
{
  "name": "Social Gallery",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Follow Our Journey"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "As Worn By Connoisseurs"
    },
    {
      "type": "text",
      "id": "account_handle",
      "label": "Instagram Handle",
      "default": "indiasilvo"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Social Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
