{%- if section.settings.show_announcement and section.settings.text != blank -%}
  <div id="AnnouncementBar-{{ section.id }}" class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; text-align: {{ section.settings.alignment }};" data-section-id="{{ section.id }}">
    <div class="container announcement-bar__container">
      <div class="announcement-bar__content">
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="announcement-bar__link">
            <span>{{ section.settings.text | escape }}</span>
          </a>
        {%- else -%}
          <span class="announcement-bar__text">{{ section.settings.text | escape }}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.show_close_button -%}
        <button type="button" class="announcement-bar__close" aria-label="{{ 'general.accessibility.close' | t }}" onclick="this.closest('.announcement-bar').style.display='none';">
          {% render 'icons', icon: 'close' %}
        </button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

<style>
  .announcement-bar {
    font-size: var(--font-size-2xs);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    padding: 0.55rem 1rem;
    font-weight: 500;
    position: relative;
    z-index: calc(var(--z-header) + 1);
    transition: opacity var(--transition-normal);
  }
  .announcement-bar__container {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .announcement-bar__content {
    flex: 1 1 auto;
  }
  .announcement-bar__link {
    color: inherit;
    text-decoration: none;
    transition: opacity var(--transition-fast);
    display: inline-block;
  }
  .announcement-bar__link:hover {
    opacity: 0.85;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .announcement-bar__close {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    opacity: 0.7;
    transition: opacity var(--transition-fast);
  }
  .announcement-bar__close:hover {
    opacity: 1;
  }
  .announcement-bar__close svg {
    width: 14px;
    height: 14px;
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Enable Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Complimentary Insured Shipping & 925 BIS Hallmarking on All Orders"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_close_button",
      "label": "Show Dismiss Button",
      "default": false
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#181615"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FAF8F5"
    }
  ]
}
{% endschema %}
