<div class="search-page-section section-spacing" data-section-id="{{ section.id }}">
  <div class="container">
    
    {%- comment -%} Search Header & Query Form {%- endcomment -%}
    <div class="section-header" style="max-width: 680px; margin: 0 auto 3rem auto; text-align: center;">
      <span class="section-header__subtitle">Indiasilvo Atelier</span>
      <h1 class="section-header__title h2">{{ 'templates.search.title' | t }}</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page-form" style="margin-top: 1.5rem; display: flex; gap: 0.5rem;">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'sections.header.search_placeholder' | t }}"
          class="search-page-input"
          aria-label="{{ 'sections.header.search_placeholder' | t }}"
          style="flex: 1;"
        >
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="btn btn-primary" style="padding: 0 1.5rem;">
          {{ 'general.accessibility.search' | t }}
        </button>
      </form>
    </div>

    {%- if search.performed -%}
      <div class="search-results-summary" style="margin-bottom: 2.5rem; text-align: center; color: var(--color-text-secondary); font-size: var(--font-size-sm);">
        {%- if search.results_count > 0 -%}
          <p>{{ 'templates.search.results_with_count' | t: count: search.results_count, terms: search.terms }}</p>
        {%- else -%}
          <div class="search-empty-state" style="padding: 3rem 1rem; max-width: 540px; margin: 0 auto;">
            <div class="search-empty-icon" style="width: 56px; height: 56px; border-radius: 50%; background-color: var(--color-surface-alt); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem auto; color: var(--color-accent-gold);">
              {% render 'icons', icon: 'search' %}
            </div>
            <h2 style="font-family: var(--font-heading); font-size: 1.6rem; margin-bottom: 0.5rem;">
              {{ 'templates.search.no_results' | t: terms: search.terms }}
            </h2>
            <p style="font-size: 13px; color: var(--color-text-muted); margin-bottom: 2rem;">
              Check your spelling or explore our signature 925 sterling silver collections.
            </p>
            <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
              <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Explore All Creations</a>
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- if search.results_count > 0 -%}
        {%- paginate search.results by section.settings.products_per_page -%}
          <div class="product-grid product-grid--{{ section.settings.columns_desktop | default: 4 }}-col">
            {%- for item in search.results -%}
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'product-card', product: item %}
                {%- when 'article' -%}
                  <div class="search-result-article-card" style="padding: 1.5rem; background: var(--color-surface); border: 1px solid var(--color-border);">
                    <span style="font-size: 10px; text-transform: uppercase; color: var(--color-accent-gold); letter-spacing: 0.1em;">Journal</span>
                    <h3 style="font-family: var(--font-heading); font-size: 1.2rem; margin: 0.5rem 0;"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                    <p style="font-size: 12px; color: var(--color-text-secondary);">{{ item.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
                  </div>
                {%- when 'page' -%}
                  <div class="search-result-page-card" style="padding: 1.5rem; background: var(--color-surface); border: 1px solid var(--color-border);">
                    <span style="font-size: 10px; text-transform: uppercase; color: var(--color-accent-gold); letter-spacing: 0.1em;">Information</span>
                    <h3 style="font-family: var(--font-heading); font-size: 1.2rem; margin: 0.5rem 0;"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                    <p style="font-size: 12px; color: var(--color-text-secondary);">{{ item.content | strip_html | truncatewords: 20 }}</p>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <div style="margin-top: 3rem;">
              {% render 'pagination', paginate: paginate %}
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}

    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Search Results",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 32,
      "step": 4,
      "label": "Results per page",
      "default": 16
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "options": [
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "4"
    }
  ]
}
{% endschema %}
