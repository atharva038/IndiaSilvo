<div class="newsletter-section section-spacing" data-section-id="{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="container container-narrow" style="text-align: center;">
    
    {%- if section.settings.subtitle != blank -%}
      <span class="section-header__subtitle">{{ section.settings.subtitle | escape }}</span>
    {%- endif -%}
    <h2 class="h2" style="margin-bottom: var(--space-sm);">{{ section.settings.title | escape }}</h2>
    {%- if section.settings.description != blank -%}
      <p style="margin-bottom: var(--space-xl); color: var(--color-text-secondary);">{{ section.settings.description | escape }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-success" style="color:var(--color-accent-gold); font-size:14px;">
          {{ 'sections.newsletter.success' | t }}
        </p>
      {%- else -%}
        <div class="newsletter-form__input-group" style="display:flex; max-width:520px; margin:0 auto; gap:0.5rem;">
          <input
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ 'sections.newsletter.placeholder' | t }}"
            autocorrect="off"
            autocapitalize="off"
            required
            style="flex:1;"
          >
          <button type="submit" class="btn btn-primary" style="white-space:nowrap;">
            {{ 'sections.newsletter.button' | t }}
          </button>
        </div>
        {%- if form.errors -%}
          <p class="form-error" style="color:#B23B3B; font-size:12px; margin-top:8px;">
            {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
          </p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}

  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F4F0EB"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The Private Circle"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Bespoke Previews & Private Salons"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Join our inner circle for priority access to limited edition drops, masterclass invitations, and bespoke concierge curation."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
